<h3><%= l(:calender_subscription_settings_header) %></h3>
<p>
  <%= label_tag 'settings[past_days]', l(:calender_subscription_settings_past_days_label) %>
  <%= text_field_tag 'settings[past_days]', @settings[:past_days], :size => 3 %>
</p>
<p>
  <%= label_tag 'settings[future_days]', l(:calender_subscription_settings_future_days_label) %>
  <%= text_field_tag 'settings[future_days]', @settings[:future_days], :size => 3 %>
</p>
<p>
  <%= label_tag 'settings[maximum_issues]', l(:calender_subscription_settings_maximum_issues_label) %>
  <%= text_field_tag 'settings[maximum_issues]', @settings[:maximum_issues], :size => 5 %>
</p>
<hr/>
<p>
  <%= label_tag 'settings[default_duration_minutes]', l(:calender_subscription_settings_default_duration_label) %>
  <%= text_field_tag 'settings[default_duration_minutes]', @settings[:default_duration_minutes], :size => 4 %>
  <br/>
  <label style="display:inline-block; margin-top:6px;">
    <%= check_box_tag 'settings[use_estimated_hours]', '1', @settings[:use_estimated_hours] %>
    <%= l(:calender_subscription_settings_use_estimated_hours_label) %>
  </label>
  <div class="info" style="color:#666; margin-top:4px;">
    <%= l(:calender_subscription_settings_use_estimated_hours_hint) %>
  </div>
</p>
<hr/>
<div style="display:flex; gap:16px; align-items:flex-start; flex-wrap: wrap;">
  <div style="flex:1; min-width:300px; max-width: 400px;">
    <%= label_tag 'settings[allowed_user_ids][]', l(:calender_subscription_settings_allowed_users_label) %><br/>
    <%= hidden_field_tag 'settings[allowed_user_ids][]', '' %>
    <div style="position: relative;">
      <%= text_field_tag 'user_picker', '', placeholder: l(:calender_subscription_settings_user_search_placeholder), data: { url: '/calendar_subscription/admin/users' }, size: 40, style: 'width:100%;' %>
      <div id="user-suggest" style="border:1px solid #ddd; display:none; max-height:200px; overflow:auto; position:absolute; top:100%; left:0; right:0; z-index:1000; background:#fff;"></div>
    </div>
    <div style="margin-top:12px;">
      <a href="#" id="open-add-user" class="icon icon-add" style="color:#268bd2;">Nutzer hinzufügen</a>
    </div>
    <div id="add-user-panel" style="margin-top:8px; display:none; border:1px solid #ddd; padding:8px; background:#fafafa;">
      <div style="display:flex; gap:8px; align-items:center; flex-wrap: wrap;">
        <input id="adv-user-input" type="text" style="flex:1; min-width: 150px;" placeholder="Nutzer suchen..." />
        <select id="adv-user-field">
          <option value="name">Anzeigename</option>
          <option value="login">Benutzername</option>
          <option value="mail">E-Mail</option>
          <option value="firstname">Vorname</option>
          <option value="lastname">Nachname</option>
        </select>
      </div>
      <div id="adv-user-results" style="margin-top:8px; border:1px solid #eee; max-height:260px; overflow:auto; background:#fff;"></div>
      <div id="adv-user-pager" style="margin-top:6px; display:flex; gap:8px; align-items:center; flex-wrap: wrap;">
        <button id="adv-prev" class="button">Zurück</button>
        <span id="adv-page"></span>
        <button id="adv-next" class="button">Weiter</button>
      </div>
    </div>
  </div>
  <div style="flex:2; min-width:500px;">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap: wrap; gap: 8px;">
      <strong>Erlaubte Nutzer (dürfen Kalender abonnieren)</strong>
      <input id="allowed-filter" type="text" placeholder="Liste filtern..." style="width:200px; min-width: 150px;" />
    </div>
    <div style="overflow-x: auto; margin-top: 6px;">
      <table class="list" style="width:100%; min-width: 600px;">
        <thead>
        <tr>
          <th style="min-width: 120px;">Name</th>
          <th style="min-width: 100px;">Login</th>
          <th style="min-width: 150px;">E‑Mail</th>
          <th style="min-width: 120px;">Aktionen</th>
        </tr>
        </thead>
        <tbody id="allowed-users-table"></tbody>
      </table>
    </div>
    <div id="user-settings" style="display:none; margin-top:12px; border:1px solid #ddd; padding:12px; background:#fafafa; border-radius: 4px;">
      <div style="margin-bottom: 12px; word-wrap: break-word;">
        <strong id="us-name"></strong> (<span id="us-login"></span>) — <span id="us-mail"></span>
      </div>
      <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; align-items: center;">
        <div>
          <label style="display: block; margin-bottom: 4px; font-weight: bold;">Modus:</label>
          <select id="us-mode" style="width: 100%;">
            <option value="redmine">Redmine</option>
            <option value="custom">Set Credentials</option>
            <option value="none">None</option>
          </select>
        </div>
        <div id="us-username-container" style="display:none;">
          <label style="display: block; margin-bottom: 4px; font-weight: bold;">Benutzername:</label>
          <input type="text" id="us-username" placeholder="Benutzername" style="width: 100%;" />
        </div>
        <div id="us-password-container" style="display:none;">
          <label style="display: block; margin-bottom: 4px; font-weight: bold;">Passwort:</label>
          <input type="password" id="us-password" placeholder="Passwort" style="width: 100%;" />
        </div>
        <div>
          <label style="display: block; margin-bottom: 4px; font-weight: bold;">Ablaufdatum:</label>
          <input type="date" id="us-exp" style="width: 100%;" />
        </div>
        <div style="display: flex; align-items: center; margin-top: 20px;">
          <label style="display: flex; align-items: center; gap: 6px;">
            <input type="checkbox" id="us-paused" />
            <span>Pause</span>
          </label>
        </div>
        <div style="display: flex; align-items: end;">
          <button id="us-save" class="button icon icon-save" style="width: 100%;">Speichern</button>
        </div>
      </div>
      <div style="margin-top:16px; padding-top: 12px; border-top: 1px solid #ddd;">
        <div style="display: flex; flex-wrap: wrap; gap: 12px;">
          <span>.ics (RSS-Key): <a id="us-link-rss" target="_blank">Link</a></span>
          <span>.ics (Login): <a id="us-link-basic" target="_blank">Link</a></span>
        </div>
      </div>
    </div>
  </div>
</div>

<% content_for :header_tags do %>
  <%= javascript_tag do %>
    $(function(){
      var $input = $('#user_picker');
      var $suggest = $('#user-suggest');
      function renderAllowedRow(u){
        var $tr = $('<tr data-user-id="'+u.id+'"></tr>');
        $tr.append('<td class="us-name" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><a href="#" class="open-settings" title="'+ (u.name || '') +'">'+ (u.name || '') +'</a></td>');
        $tr.append('<td class="us-login" style="max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="'+ (u.login || '') +'">'+ (u.login || '') +'</td>');
        $tr.append('<td class="us-mail" style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="'+ (u.mail || '') +'">'+ (u.mail || '') +'</td>');
        $tr.append('<td style="white-space: nowrap;"><a href="#" class="open-settings icon icon-settings">Konfigurieren</a> <a href="#" class="remove-user icon icon-del">Entfernen</a></td>');
        $tr.append('<input type="hidden" name="settings[allowed_user_ids][]" value="'+u.id+'" />');
        return $tr;
      }
      function addUser(u){
        if($('#allowed-users-table tr[data-user-id="'+u.id+'"]').length){ return; }
        // persist immediately
        $.post('/calendar_subscription/admin/allowed', { user_id: u.id });
        $('#allowed-users-table').append(renderAllowedRow(u));
      }
      function loadAllowed(){
        $.getJSON('/calendar_subscription/admin/allowed', function(list){
          var $t = $('#allowed-users-table').empty();
          $.each(list, function(_, u){ $t.append(renderAllowedRow(u)); });
        });
      }
      $('#allowed-users-table').on('click', '.remove-user', function(e){
        e.preventDefault();
        var $tr = $(this).closest('tr');
        var uid = $tr.data('user-id');
        $.ajax({ url: '/calendar_subscription/admin/allowed/'+uid, method: 'DELETE' });
        $tr.remove();
      });
      $('#allowed-users-table').on('click', '.open-settings, .us-name a', function(e){
        e.preventDefault();
        var uid = $(this).closest('tr').data('user-id');
        $.getJSON('/calendar_subscription/admin/user/'+uid, function(resp){
          $('#user-settings').show();
          $('#user-settings').data('user-id', uid);
          $('#us-name').text(resp.user.name || '');
          $('#us-login').text(resp.user.login || '');
          $('#us-mail').text(resp.user.mail || '');
          $('#us-link-rss').attr('href', resp.links.ics_rss);
          $('#us-link-basic').attr('href', resp.links.ics_basic);
          var cred = resp.credential || {};
          var mode = cred.mode || 'redmine';
          $('#us-mode').val(mode).trigger('change');
          $('#us-username').val(cred.username || '');
          $('#us-exp').val(cred.expires_at ? cred.expires_at.substring(0,10) : '');
          $('#us-paused').prop('checked', !!cred.paused);
        });
      });
      $('#us-mode').on('change', function(){
        var v = $(this).val();
        if(v === 'custom'){ $('#us-username-container,#us-password-container').show(); } else { $('#us-username-container,#us-password-container').hide(); }
      });
      $('#us-save').on('click', function(e){
        e.preventDefault();
        var uid = $('#user-settings').data('user-id');
        var payload = {
          user_id: uid,
          mode: $('#us-mode').val(),
          username: $('#us-username').val(),
          expires_at: $('#us-exp').val(),
          paused: $('#us-paused').is(':checked')
        };
        var pw = $('#us-password').val();
        if(payload.mode === 'custom' && pw){ payload.password = pw; }
        $.post('/calendar_subscription/admin/credentials', payload, function(){
          $('#us-save').text('Gespeichert'); setTimeout(function(){ $('#us-save').text('Speichern'); }, 1000);
        });
      });
      $('#allowed-filter').on('keyup', function(){
        var term = $(this).val().toLowerCase();
        $('#allowed-users-table tr').each(function(){
          var text = $(this).text().toLowerCase();
          $(this).toggle(text.indexOf(term) !== -1);
        });
      });
      function renderSuggestions(items){
        if(items.length === 0){ $suggest.hide(); return; }
        $suggest.empty();
        $.each(items, function(_, u){
          var row = $('<div style="padding:6px 8px; cursor:pointer; border-bottom:1px solid #eee;"></div>');
          var label = u.name + ' ('+ u.login +')' + (u.mail ? ' — ' + u.mail : '');
          row.text(label);
          row.on('mouseenter', function(){ $(this).css('background','#f0f0f0'); });
          row.on('mouseleave', function(){ $(this).css('background','transparent'); });
          row.on('click', function(){ addUser(u); $input.val(''); $suggest.hide(); });
          $suggest.append(row);
        });
        $suggest.show();
      }
      var debounceTimer = null;
      $input.on('keyup', function(){
        var term = $.trim($input.val());
        if(term.length < 2){ $suggest.hide(); return; }
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function(){
          $.getJSON($input.data('url'), { name: term }, function(data){
            var items = $.map(data, function(u){ return { id: u.id, name: u.name, login: u.login }; });
            renderSuggestions(items);
          });
        }, 200);
      });
      $(document).on('click', function(e){
        if(!$(e.target).closest('#user_picker, #user-suggest').length){ $suggest.hide(); }
      });

      $('#allowed-users-list').on('change', '.cred-mode', function(){
        var v = $(this).val();
        var $p = $(this).closest('.user-pill');
        if(v === 'custom'){ $p.find('.cred-user,.cred-pass').show(); } else { $p.find('.cred-user,.cred-pass').hide(); }
      });
      $('#allowed-users-list').on('click', '.save-cred', function(e){
        e.preventDefault();
        var $p = $(this).closest('.user-pill');
        var userId = $(this).data('user-id');
        var mode = $p.find('.cred-mode').val();
        var username = $p.find('.cred-user').val();
        var password = $p.find('.cred-pass').val();
        var exp = $p.find('.cred-exp').val();
        var paused = $p.find('.cred-paused').is(':checked');
        var payload = { user_id: userId, mode: mode, username: username, expires_at: exp, paused: paused };
        if(mode === 'custom' && password){ payload.password = password; }
        $.ajax({ url: '/calendar_subscription/admin/credentials', method: 'POST', data: payload, success: function(){
          $(e.currentTarget).text('✔'); setTimeout(function(){ $(e.currentTarget).text('💾'); }, 800);
        }, error: function(xhr){ alert('Error: ' + (xhr.responseJSON && xhr.responseJSON.errors ? xhr.responseJSON.errors.join(', ') : xhr.statusText)); }});
      });

      // Advanced user add panel
      $('#open-add-user').on('click', function(e){ e.preventDefault(); $('#add-user-panel').toggle(); $('#adv-user-input').focus(); });
      var advTimer = null;
      var advPage = 1;
      function advFetch(){
        var term = $.trim($('#adv-user-input').val());
        var field = $('#adv-user-field').val();
        if(term.length < 1){
          // Leerlauf: zeige erste Seite alphabetisch
        }
        $.getJSON('/calendar_subscription/admin/users', { name: term, by: field, page: advPage, per: 8 }, function(resp){
          var list = resp.users || [];
          var $r = $('#adv-user-results').empty();
          $.each(list, function(_, u){
            var match = true;
            if(term.length >= 1){
              if(field === 'login' && u.login.toLowerCase().indexOf(term.toLowerCase()) === -1) match = false;
              if(field === 'mail' && (u.mail||'').toLowerCase().indexOf(term.toLowerCase()) === -1) match = false;
              if(field === 'firstname' && u.name.toLowerCase().indexOf(term.toLowerCase()) === -1) match = false;
              if(field === 'lastname' && u.name.toLowerCase().indexOf(term.toLowerCase()) === -1) match = false;
            }
            if(!match) return;
            var row = $('<div style="padding:6px 8px; border-bottom:1px solid #eee; cursor:pointer;"></div>');
            row.text(u.name + ' ('+u.login+') '+(u.mail||''));
            row.on('click', function(){ addUser(u); });
            row.on('mouseenter', function(){ $(this).css('background','#f0f0f0'); });
            row.on('mouseleave', function(){ $(this).css('background','transparent'); });
            $r.append(row);
          });
          $('#adv-page').text('Seite ' + resp.page + ' / ' + resp.total_pages);
          $('#adv-prev').prop('disabled', resp.page <= 1);
          $('#adv-next').prop('disabled', resp.page >= resp.total_pages);
        });
      }
      $('#adv-user-input, #adv-user-field').on('keyup change', function(){ advPage = 1; clearTimeout(advTimer); advTimer = setTimeout(advFetch, 200); });
      $('#adv-prev').on('click', function(e){ e.preventDefault(); if(advPage>1){ advPage--; advFetch(); }});
      $('#adv-next').on('click', function(e){ e.preventDefault(); advPage++; advFetch(); });
      // initial load
      advFetch();
      loadAllowed();
    });
  <% end %>
<% end %>
