<h3><%= l(:calender_subscription_settings_header) %></h3>
<p>
  <%= label_tag 'settings[past_days]', l(:calender_subscription_settings_past_days_label) %>
  <%= text_field_tag 'settings[past_days]', @settings[:past_days], :size => 3 %>
</p>
<p>
  <%= label_tag 'settings[future_days]', l(:calender_subscription_settings_future_days_label) %>
  <%= text_field_tag 'settings[future_days]', @settings[:future_days], :size => 3 %>
</p>
<p>
  <%= label_tag 'settings[maximum_issues]', l(:calender_subscription_settings_maximum_issues_label) %>
  <%= text_field_tag 'settings[maximum_issues]', @settings[:maximum_issues], :size => 5 %>
</p>
<hr/>
<p>
  <%= label_tag 'settings[default_duration_minutes]', l(:calender_subscription_settings_default_duration_label) %>
  <%= text_field_tag 'settings[default_duration_minutes]', @settings[:default_duration_minutes], :size => 4 %>
  <br/>
  <label style="display:inline-block; margin-top:6px;">
    <%= check_box_tag 'settings[use_estimated_hours]', '1', @settings[:use_estimated_hours] %>
    <%= l(:calender_subscription_settings_use_estimated_hours_label) %>
  </label>
  <div class="info" style="color:#666; margin-top:4px;">
    <%= l(:calender_subscription_settings_use_estimated_hours_hint) %>
  </div>
</p>
<hr/>
<p style="max-width: 720px;">
  <%= label_tag 'settings[allowed_user_ids][]', l(:calender_subscription_settings_allowed_users_label) %><br/>
  <%= hidden_field_tag 'settings[allowed_user_ids][]', '' %>
  <div style="position: relative; max-width: 420px;">
    <%= text_field_tag 'user_picker', '', placeholder: l(:calender_subscription_settings_user_search_placeholder), data: { url: '/calendar_subscription/admin/users' }, size: 40, style: 'width:100%;' %>
    <div id="user-suggest" style="border:1px solid #ddd; display:none; max-height:200px; overflow:auto; position:absolute; top:100%; left:0; right:0; z-index:1000; background:#fff;"></div>
  </div>
  <div id="allowed-users-list" style="margin-top:8px; display:flex; flex-wrap:wrap; gap:6px;">
    <% Array(@settings[:allowed_user_ids]).each do |uid| %>
      <% user = User.find_by_id(uid) %>
      <% if user %>
        <div class="user-pill" style="display:inline-flex; align-items:center; gap:6px; border:1px solid #ddd; border-radius:12px; padding:4px 8px; background:#f9f9f9;">
          <%= hidden_field_tag 'settings[allowed_user_ids][]', user.id %>
          <span><%= h(user.name) %> (<%= h(user.login) %>)</span>
          <a href="#" class="edit-cred" data-user-id="<%= user.id %>" title="Zugangsdaten bearbeiten">⚙</a>
          <a href="#" class="remove-user" data-user-id="<%= user.id %>" title="Entfernen">×</a>
        </div>
      <% end %>
    <% end %>
  </div>
  <div style="margin-top:12px;">
    <a href="#" id="open-add-user" class="icon icon-add" style="color:#268bd2;">Nutzer hinzufügen</a>
  </div>
  <div id="add-user-panel" style="margin-top:8px; display:none; max-width:720px; border:1px solid #ddd; padding:8px; background:#fafafa;">
    <div style="display:flex; gap:8px; align-items:center;">
      <input id="adv-user-input" type="text" style="flex:1;" placeholder="Nutzer suchen..." />
      <select id="adv-user-field">
        <option value="name">Anzeigename</option>
        <option value="login">Benutzername</option>
        <option value="mail">E-Mail</option>
        <option value="firstname">Vorname</option>
        <option value="lastname">Nachname</option>
      </select>
    </div>
    <div id="adv-user-results" style="margin-top:8px; border:1px solid #eee; max-height:260px; overflow:auto; background:#fff;"></div>
  </div>
</p>

<% content_for :header_tags do %>
  <%= javascript_tag do %>
    $(function(){
      var $input = $('#user_picker');
      var $suggest = $('#user-suggest');
      function addUser(user){
        if($('#allowed-users-list input[value="'+user.id+'"]').length){ return; }
        var pill = $('<div class="user-pill" style="display:inline-flex; align-items:center; gap:6px; border:1px solid #ddd; border-radius:12px; padding:6px 10px; background:#f9f9f9;">'
          + '<input type="hidden" name="settings[allowed_user_ids][]" value="'+user.id+'" />'
          + '<span></span>'
          + '<select class="cred-mode" data-user-id="'+user.id+'" title="Authentifizierung"><option value="redmine">Redmine</option><option value="custom">Set Credentials</option><option value="none">None</option></select>'
          + '<input type="text" class="cred-user" data-user-id="'+user.id+'" placeholder="Benutzername" style="width:120px; display:none;" />'
          + '<input type="password" class="cred-pass" data-user-id="'+user.id+'" placeholder="Passwort" style="width:120px; display:none;" />'
          + '<input type="date" class="cred-exp" data-user-id="'+user.id+'" title="Ablaufdatum" />'
          + '<label style="margin:0 4px; font-size:12px;"><input type="checkbox" class="cred-paused" data-user-id="'+user.id+'" /> Pause</label>'
          + '<a href="#" class="save-cred" data-user-id="'+user.id+'" title="Speichern">💾</a>'
          + '<a href="#" class="remove-user" data-user-id="'+user.id+'" title="Entfernen">×</a>'
          + '</div>');
        pill.find('span').text(user.name + ' ('+ user.login +')');
        $('#allowed-users-list').append(pill);
      }
      $('#allowed-users-list').on('click', '.remove-user', function(e){
        e.preventDefault();
        $(this).closest('.user-pill').remove();
      });
      function renderSuggestions(items){
        if(items.length === 0){ $suggest.hide(); return; }
        $suggest.empty();
        $.each(items, function(_, u){
          var row = $('<div style="padding:6px 8px; cursor:pointer; border-bottom:1px solid #eee;"></div>');
          var label = u.name + ' ('+ u.login +')' + (u.mail ? ' — ' + u.mail : '');
          row.text(label);
          row.on('mouseenter', function(){ $(this).css('background','#f0f0f0'); });
          row.on('mouseleave', function(){ $(this).css('background','transparent'); });
          row.on('click', function(){ addUser(u); $input.val(''); $suggest.hide(); });
          $suggest.append(row);
        });
        $suggest.show();
      }
      var debounceTimer = null;
      $input.on('keyup', function(){
        var term = $.trim($input.val());
        if(term.length < 2){ $suggest.hide(); return; }
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function(){
          $.getJSON($input.data('url'), { name: term }, function(data){
            var items = $.map(data, function(u){ return { id: u.id, name: u.name, login: u.login }; });
            renderSuggestions(items);
          });
        }, 200);
      });
      $(document).on('click', function(e){
        if(!$(e.target).closest('#user_picker, #user-suggest').length){ $suggest.hide(); }
      });

      $('#allowed-users-list').on('change', '.cred-mode', function(){
        var v = $(this).val();
        var $p = $(this).closest('.user-pill');
        if(v === 'custom'){ $p.find('.cred-user,.cred-pass').show(); } else { $p.find('.cred-user,.cred-pass').hide(); }
      });
      $('#allowed-users-list').on('click', '.save-cred', function(e){
        e.preventDefault();
        var $p = $(this).closest('.user-pill');
        var userId = $(this).data('user-id');
        var mode = $p.find('.cred-mode').val();
        var username = $p.find('.cred-user').val();
        var password = $p.find('.cred-pass').val();
        var exp = $p.find('.cred-exp').val();
        var paused = $p.find('.cred-paused').is(':checked');
        var payload = { user_id: userId, mode: mode, username: username, expires_at: exp, paused: paused };
        if(mode === 'custom' && password){ payload.password = password; }
        $.ajax({ url: '/calendar_subscription/admin/credentials', method: 'POST', data: payload, success: function(){
          $(e.currentTarget).text('✔'); setTimeout(function(){ $(e.currentTarget).text('💾'); }, 800);
        }, error: function(xhr){ alert('Error: ' + (xhr.responseJSON && xhr.responseJSON.errors ? xhr.responseJSON.errors.join(', ') : xhr.statusText)); }});
      });

      // Advanced user add panel
      $('#open-add-user').on('click', function(e){ e.preventDefault(); $('#add-user-panel').toggle(); $('#adv-user-input').focus(); });
      var advTimer = null;
      function advFetch(){
        var term = $.trim($('#adv-user-input').val());
        var field = $('#adv-user-field').val();
        if(term.length < 2){ $('#adv-user-results').empty(); return; }
        var q = term;
        $.getJSON('/calendar_subscription/admin/users', { name: q }, function(items){
          var $r = $('#adv-user-results').empty();
          $.each(items, function(_, u){
            var match = true;
            if(field === 'login' && u.login.indexOf(term) === -1) match = false;
            if(field === 'mail' && (u.mail||'').indexOf(term) === -1) match = false;
            if(field === 'firstname' && u.name.split(' ')[0].toLowerCase().indexOf(term.toLowerCase()) === -1) match = false;
            if(field === 'lastname' && u.name.split(' ').slice(-1)[0].toLowerCase().indexOf(term.toLowerCase()) === -1) match = false;
            if(!match) return;
            var row = $('<div style="padding:6px 8px; border-bottom:1px solid #eee; cursor:pointer;"></div>');
            row.text(u.name + ' ('+u.login+') '+(u.mail||''));
            row.on('click', function(){ addUser(u); });
            row.on('mouseenter', function(){ $(this).css('background','#f0f0f0'); });
            row.on('mouseleave', function(){ $(this).css('background','transparent'); });
            $r.append(row);
          });
        });
      }
      $('#adv-user-input, #adv-user-field').on('keyup change', function(){ clearTimeout(advTimer); advTimer = setTimeout(advFetch, 200); });
    });
  <% end %>
<% end %>
