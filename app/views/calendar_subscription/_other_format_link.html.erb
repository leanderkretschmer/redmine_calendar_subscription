<% settings = Setting.plugin_redmine_calendar_subscription || {} %>
<% allowed_ids = Array(settings[:allowed_user_ids]).map(&:to_i) %>
<% allowed = allowed_ids.empty? || allowed_ids.include?(User.current.id) %>
<% if allowed && User.current.allowed_to?(:subscribe_calendar, project, :global => true) %>
 <% rss_key = User.current.api_key || SecureRandom.hex(16) %>
 <% ical_url_rss = calendar_subscription_url(params.except('controller','page').merge(:key => rss_key, :format => 'ics')) %>
 <% ical_url_basic = calendar_subscription_url(params.except('controller','page').merge(:format => 'ics')) %>
 <%= javascript_tag do %>
  $(function() {
    $('.other-formats').append(<%= raw (content_tag 'span', (link_to 'iCal', ical_url_rss, :rel => 'nofollow', :style => 'ics')).to_json %>);
    $('.other-formats').append(<%= raw (content_tag 'span', (link_to 'iCal (Login)', ical_url_basic, :rel => 'nofollow', :style => 'ics')).to_json %>);
   });
 <% end %>
<% end %>
