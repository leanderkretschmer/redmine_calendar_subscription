<% # Renders in Administration -> Users -> New/Edit user form %>
<% user = @user %>
<div class="box tabular">
  <p>
    <label>Kalender-Abo</label>
    <% settings = Setting.plugin_redmine_calendar_subscription || {} %>
    <% allowed = Array(settings[:allowed_user_ids]).map(&:to_i) %>
    <% is_enabled = allowed.include?(user.id) %>
    <input type="checkbox" id="cs-sync" <%= 'checked' if is_enabled %> />
    <span class="info">Wenn aktiviert, wird dieser Nutzer in der Plugin-Config-Liste angezeigt und kann den Kalender über Redmine-Login abrufen.</span>
    <% rss_key = user.respond_to?(:rss_key) ? user.rss_key : nil %>
    <span id="cs-links" style="margin-left:8px; <%= 'display:none;' unless is_enabled %>">
      <% if rss_key.present? %>
        <%= link_to 'iCal (RSS-Key)', calendar_subscription_path(key: rss_key, format: 'ics'), target: '_blank' %> |
      <% end %>
      <%= link_to 'iCal (Login)', calendar_subscription_path(format: 'ics'), target: '_blank' %>
    </span>
  </p>
</div>

<% content_for :header_tags do %>
  <%= javascript_tag do %>
    $(function(){
      var csrf = $('meta[name="csrf-token"]').attr('content');
      if(csrf){ $.ajaxSetup({ headers: { 'X-CSRF-Token': csrf } }); }
      $('#cs-sync').on('change', function(){
        var enabled = $(this).is(':checked');
        var url = enabled ? '/calendar_subscription/admin/allowed' : '/calendar_subscription/admin/allowed/<%= user.id %>';
        var method = enabled ? 'POST' : 'DELETE';
        var data = enabled ? { user_id: <%= user.id %> } : {};
        $.ajax({ url: url, method: method, data: data, success: function(){
          if(enabled){ $('#cs-links').show(); } else { $('#cs-links').hide(); }
        }, error: function(){ alert('Fehler beim Aktualisieren'); } });
      });
    });
  <% end %>
<% end %>


